# --- API / desktop ---
API_PORT=3000
API_HOST=127.0.0.1
# Для Docker / внешнего доступа: API_HOST=0.0.0.0
CORS_ORIGINS=http://127.0.0.1:5173
CREDENTIALS_PATH=./data/credentials.json
# Обязательно замените перед любым внешним запуском
LETTER_BOX_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-an-independent-random-secret
ALLOW_REGISTRATION=false
LETTER_BOX_API_URL=http://127.0.0.1:3000
# Shared OAuth clients (Gmail PKCE loopback + Yandex manual code + server token refresh)
# Gmail: Google Cloud Desktop app, Publishing status Production
OAUTH_GMAIL_CLIENT_ID=
OAUTH_GMAIL_CLIENT_SECRET=
# Yandex: тип «Для доступа к API», redirect https://oauth.yandex.ru/verification_code
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
# Mail.ru — без OAuth, только пароль приложения
# Опционально зафиксировать loopback-порт Gmail
# OAUTH_LOOPBACK_PORT=43110
# За reverse-proxy (nginx/Caddy): TRUST_PROXY=true

# --- Инфраструктура ---
DATABASE_URL=postgresql://letter_box:letter_box_dev@127.0.0.1:5432/letter_box
REDIS_URL=redis://127.0.0.1:6379
SYNC_WORKER_CONCURRENCY=4
# Periodic IMAP sync (backend scheduler; desktop tick remains as UI fallback)
SYNC_INBOX_INTERVAL_MS=60000
SYNC_FOLDER_INTERVAL_MS=300000
# Connection/auth failure backoff: base * 2^(n-1), capped
SYNC_BACKOFF_BASE_MS=60000
SYNC_BACKOFF_MAX_MS=1800000
# History backfill (newest→oldest); lock released between batches
BACKFILL_BATCH_SIZE=300
BACKFILL_BATCH_DELAY_MS=1500
TRUST_PROXY=false

# --- AI-классификация (Ollama) ---
# Вариант A (macOS, быстрее — Metal): приложение https://ollama.com + ollama pull …
# Вариант B (Docker, стабильнее для worker): docker compose --profile ai up -d ollama
#   затем: docker compose exec ollama ollama pull qwen3:0.6b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_ENABLED=true
# Для docker-worker + native Ollama.app:
# OLLAMA_URL=http://host.docker.internal:11434
# Для docker-worker + compose ollama (profile ai):
# OLLAMA_URL=http://ollama:11434
# Safety-net sweep for pending tags (event-driven enqueue is primary)
TAG_SWEEP_INTERVAL_MS=60000
TAG_MAX_ATTEMPTS=3
